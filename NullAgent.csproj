<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<AssemblyName>NullAgent</AssemblyName>
		<RootNamespace>NullAgentLib</RootNamespace>
		<Product>NullAgent</Product>
		<Company>Toast</Company>
		<Copyright>Copyright © Toast 2026</Copyright>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<Version>1.0.0</Version>
		<Description>Drop-in local AI voice agent for Unity/BepInEx menus. Made by Toast.</Description>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NoWarn>CS0649;CS0169;CS0414;CS8632</NoWarn>
		<GtRoot Condition="'$(GtRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GtRoot>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Source\**" />
		<None Remove="Source\**" />
		<EmbeddedResource Remove="Source\**" />
		<None Remove="payload\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="payload\NullListen.exe">
			<LogicalName>NullAgentLib.bundle.NullListen.exe</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="payload\NullPlay.exe">
			<LogicalName>NullAgentLib.bundle.NullPlay.exe</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="payload\boot.mp3">
			<LogicalName>NullAgentLib.bundle.boot.mp3</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="payload\listening.mp3">
			<LogicalName>NullAgentLib.bundle.listening.mp3</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="BepInEx">
			<HintPath>$(GtRoot)\BepInEx\core\BepInEx.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\UnityEngine.UI.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\UnityEngine.UIModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.AudioModule">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.UnityWebRequestModule">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.UnityWebRequestAudioModule">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.TextRenderingModule">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\Unity.TextMeshPro.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\Newtonsoft.Json.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="PhotonUnityNetworking" publicize="true">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\PhotonUnityNetworking.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="PhotonRealtime" publicize="true">
			<HintPath>$(GtRoot)\Gorilla Tag_Data\Managed\PhotonRealtime.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>
